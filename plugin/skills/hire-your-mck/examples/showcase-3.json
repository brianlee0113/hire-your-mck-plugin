 "storyline": {
  "governing_thought": "Moving Riverside and Oak Park to online booking is the fastest way to cut no-shows across the network",
  "exec_summary": [
   {
    "id": "1",
    "text": "No-shows are the network's largest avoidable loss, and clinics that book online lose far fewer patients",
    "supports": [
     "4",
     "5",
     "6",
     "7"
    ],
    "sub_points": [
     {
      "text": "No-shows cost the network tens of thousands of visits and millions of dollars a year",
      "slide_id": "4"
     },
     {
      "text": "Clinics that book most visits online have the lowest no-show rates; Riverside and Oak Park book the fewest",
      "slide_id": "5"
     },
     {
      "text": "Reminder letters have not moved the network rate in four years",
      "slide_id": "7"
     }
    ]
   },
   {
    "id": "2",
    "text": "Riverside trails the network on every operating measure, and phone check-in is the biggest cause",
    "supports": [
     "9",
     "10",
     "11"
    ],
    "sub_points": [
     {
      "text": "Riverside is last of the clinics on wait time, no-shows, satisfaction and throughput",
      "slide_id": "9"
     },
     {
      "text": "Phone check-in explains half of its extra wait over the network median",
      "slide_id": "10"
     },
     {
      "text": "Three changes would bring it to the median within a year",
      "slide_id": "11"
     }
    ]
   },
   {
    "id": "3",
    "text": "Patients say they miss visits because booking is hard, so online booking and text reminders go first",
    "supports": [
     "13",
     "14",
     "15"
    ],
    "sub_points": [
     {
      "text": "Trouble booking or rescheduling is the most common reason patients give",
      "slide_id": "13"
     },
     {
      "text": "Patients describe phone queues and late letters, not a lack of need",
      "slide_id": "14"
     },
     {
      "text": "Riverside and Oak Park switch first, the rest of the network by the end of 2027",
      "slide_id": "15"
     }
    ]
   }
  ],
  "next_steps": [
   {
    "action": "Move Riverside and Oak Park to online booking with text reminders",
