      },
      "body": {
        "kind": "process",
        "steps": [
          {
            "header": "Design",
            "detail": [
              "Build the pricing index",
              "Pick pilot accounts",
              "Set success metrics",
              "Agree the go / no-go metrics with finance",
              "Brief the sales team"
            ],
            "footer": "Exit: index and metrics signed off"
          },
          {
            "header": "Pilot",
            "detail": [
              "Sign index contracts",
              "Open the Dallas cross-dock",
              "Track margin weekly",
              "Weekly margin and churn review",
              "Fix issues before scaling"
            ],
            "emphasis": true,
            "footer": "Gate: margin and churn on target"
          },
          {
            "header": "Scale in the Sun Belt",
            "detail": [
              "Extend to all large accounts",
              "Open the Atlanta cross-dock",
              "Move small accounts to inside sales",
              "Hire the inside sales team",
              "Train account managers on the index"
            ],
            "footer": "Exit: Sun Belt fully on index"
          },
          {
            "header": "Roll out nationally",
            "detail": [
              "Region-by-region launch",
              "Same playbook and metrics",
              "Review after each region",
              "Launch region by region",
              "Retire the annual tender"
            ],
            "footer": "Gate: national go / no-go"
          }
        ]
      },
      "callout": {
        "target": "Pilot",
        "header": "Decision point",
        "detail": "Scale only if margin and churn move as planned"
