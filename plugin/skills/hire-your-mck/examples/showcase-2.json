        "sub_points": [
          {
            "text": "Pilot with top accounts, then the Sun Belt, then national",
            "slide_id": "3"
          },
          {
            "text": "Pilot review in Q2 2027, national go / no-go in Q2 2028",
            "slide_id": "4"
          }
        ]
      },
      {
        "id": "3",
        "text": "Five levers close the $40M gap, led by pricing, as a peer has shown",
        "supports": [
          "5",
